    "optionalVpmDependencies": {
      "orbiters.refit": {
        "version": ">=0.5.3 <1.0.0",
        "displayName": "ReFit",
        "reason": "Adds the ReFit avatar options panel for adapting clothing and accessory meshes to the applied custom base."
      },
      "orbiters.unitgit": {
        "version": ">=0.1.0 <1.0.0",
        "displayName": "Unit Git",
        "reason": "Records MCB release checkpoints and generated ReFit files through Unit Git when available."
      },
      "orbiters.mixer": {
        "version": ">=0.1.0 <0.2.0",
        "displayName": "Mixer",
        "reason": "Opens the custom base's scene in Blender through the Mixer link, with Blender's edits shown on the avatar live, and brings Mixer's sculpt, weight paint and armature tools."
      },
      "com.poiyomi.toon": {
        "version": ">=9.0.0 <10.0.0",
        "displayName": "Poiyomi Toon",
        "reason": "Recommended for custom veins and locked Poiyomi material workflows."
      }
    }
  },
