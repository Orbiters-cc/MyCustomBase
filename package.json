    "com.vrchat.avatars": ">=3.7.0 <4.0.0",
    "orbiters.toolkit": ">=0.4.0 <0.5.0"
  },
  "orbiters": {
    "dependencyDisplayNames": {
      "com.vrchat.core.vpm-resolver": "VRChat Package Resolver",
      "com.vrcfury.vrcfury": "VRCFury",
      "com.poiyomi.toon": "Poiyomi Toon",
      "orbiters.refit": "ReFit",
      "orbiters.unitgit": "Unit Git",
      "orbiters.toolkit": "Orbiters Toolkit",
      "orbiters.mixer": "Mixer"
    },
    "repositories": [
      {
        "url": "https://orbiters.cc/vpm/orbiters/index.json",
        "packages": [
          "orbiters.refit",
          "orbiters.unitgit",
          "orbiters.toolkit",
          "orbiters.mixer"
        ]
      },
      {
        "url": "https://vcc.vrcfury.com/",
        "packages": [
          "com.vrcfury.vrcfury"
        ]
      },
      {
        "url": "https://poiyomi.github.io/vpm/index.json",
