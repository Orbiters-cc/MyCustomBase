.mcb-avatar-options {
    background-color: rgba(0,0,0,0);
    padding: 10px 24px 18px 24px;
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    min-width: 0;
    overflow: visible;
}

.mcb-avatar-options--asset-view {
    padding-top: 0;
}

.mcb-avatar-options-host {
    flex-grow: 0;
    flex-shrink: 0;
    min-width: 0;
    overflow: visible;
}

.mcb-avatar-option {
    margin-bottom: 12px;
    min-width: 0;
    overflow: hidden;
}

/* Modes: tiles per category, green accent like the gallery's selected states. */
.mcb-modes__header { flex-direction: row; align-items: center; margin-bottom: 12px; }
.mcb-modes__badge {
    width: 34px; height: 34px; margin-right: 10px; border-radius: 17px; align-items: center; justify-content: center; flex-shrink: 0;
    background-color: rgba(0, 218, 109, 0.14); border-width: 1px; border-color: rgba(0, 218, 109, 0.35);
}
.mcb-modes__badge .orb-icon { width: 18px; height: 18px; --icon-color: #3cf29a; }
.mcb-modes__titles { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.mcb-modes__caption { color: #8f8f96; font-size: 11px; white-space: normal; margin-top: 2px; }
.mcb-modes__group { margin-top: 4px; margin-bottom: 8px; }
.mcb-modes__group-header { flex-direction: row; align-items: center; margin-bottom: 6px; }
.mcb-modes__group-name { color: #a9a9b0; font-size: 10px; -unity-font-style: bold; letter-spacing: 1px; }
.mcb-modes__group-hint { color: #6f6f76; font-size: 10px; margin-left: 8px; }
.mcb-modes__tiles { flex-direction: row; flex-wrap: wrap; margin-right: -8px; }
.mcb-modes__error { color: #ff8f93; font-size: 11px; white-space: normal; margin-top: 4px; }

.mcb-mode-tile {
    flex-direction: row; align-items: center; flex-grow: 1; flex-basis: 150px; min-width: 130px; max-width: 260px; height: 48px;
    margin: 0 8px 8px 0; padding: 0 12px 0 8px; border-radius: 14px;
    background-color: #2a2b30; border-width: 1px; border-color: rgba(255, 255, 255, 0.05);
    transition-property: background-color, border-color, scale, translate; transition-duration: 0.16s, 0.16s, 0.12s, 0.16s;
    transition-timing-function: ease-out-cubic;
}
.mcb-mode-tile:hover { background-color: #303137; border-color: rgba(255, 255, 255, 0.1); translate: 0 -1px; }
.mcb-mode-tile:active { scale: 0.97 0.97; }
.mcb-mode-tile--pulse { scale: 1.03 1.03; }
.mcb-mode-tile__bubble {
    width: 30px; height: 30px; margin-right: 10px; border-radius: 15px; align-items: center; justify-content: center; flex-shrink: 0;
    background-color: #212125; transition-property: background-color; transition-duration: 0.16s;
}
.mcb-mode-tile__bubble .orb-icon { width: 16px; height: 16px; --icon-color: #9a9aa0; }
.mcb-mode-tile__label { flex-grow: 1; flex-shrink: 1; min-width: 0; color: #d6d6dc; font-size: 12px; -unity-font-style: bold; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; -unity-text-align: middle-left; margin-right: 8px; }
.mcb-mode-tile__check {
    width: 20px; height: 20px; border-radius: 10px; align-items: center; justify-content: center; flex-shrink: 0;
    border-width: 1.5px; border-color: rgba(255, 255, 255, 0.18); transition-property: background-color, border-color; transition-duration: 0.16s;
}
.mcb-mode-tile__check .orb-icon { width: 12px; height: 12px; --icon-color: rgba(0, 0, 0, 0); }
.mcb-mode-tile__switch { flex-shrink: 0; }

.mcb-mode-tile--on { background-color: rgba(0, 218, 109, 0.12); border-color: rgba(0, 218, 109, 0.55); }
.mcb-mode-tile--on:hover { background-color: rgba(0, 218, 109, 0.18); border-color: rgba(0, 218, 109, 0.7); }
.mcb-mode-tile--on .mcb-mode-tile__bubble { background-color: #00DA6D; }
.mcb-mode-tile--on .mcb-mode-tile__bubble .orb-icon { --icon-color: #0b0b0b; }
.mcb-mode-tile--on .mcb-mode-tile__label { color: #f2fff8; }
.mcb-mode-tile--on .mcb-mode-tile__check { background-color: #00DA6D; border-color: #00DA6D; }
.mcb-mode-tile--on .mcb-mode-tile__check .orb-icon { --icon-color: #0b0b0b; }

.mcb-avatar-refit {
    position: relative;
}

.mcb-avatar-refit__icon {
    position: absolute;
    top: 12px;
    right: 14px;
    width: 19.5px;
    height: 17.5px;
}

.mcb-avatar-refit__icon-bar {
    position: absolute;
    background-color: #d9d9d9;
}

.mcb-avatar-refit__icon-top {
    left: 0;
    right: 0;
    top: 0;
    height: 1.859px;
}

.mcb-avatar-refit__icon-middle {
    left: 0;
    right: 0;
    top: 6.346px;
    height: 4.936px;
}

.mcb-avatar-refit__icon-bottom-left,
.mcb-avatar-refit__icon-bottom-center,
.mcb-avatar-refit__icon-bottom-right {
    bottom: 0;
    width: 4.637px;
    height: 1.539px;
}

.mcb-avatar-refit__icon-bottom-left {
    left: 0;
}

.mcb-avatar-refit__icon-bottom-center {
    left: 7.495px;
}

.mcb-avatar-refit__icon-bottom-right {
    right: 0;
}

.mcb-avatar-refit > .mcb-avatar-option__title {
    margin-right: 30px;
}

.mcb-avatar-option__title {
    margin-bottom: 10px;
}

.mcb-adjust-material-host {
    padding-top: 0;
}

.mcb-adjust-material__warning {
    margin-top: 8px;
}

.mcb-adjust-material__action {
    align-self: flex-start;
    min-width: 170px;
    margin-top: 8px;
}

.mcb-adjust-material__normal-label {
    margin-top: 8px;
    margin-bottom: 3px;
}

.mcb-adjust-material__normal-field {
    min-height: 22px;
    max-width: 100%;
}

.mcb-adjust-material__normal-field .unity-base-field__input,
.mcb-adjust-material__normal-field .unity-object-field__input,
.mcb-adjust-material__normal-field .unity-object-field__object {
    background-color: #2b2b2b;
    color: #d1d1d1;
    border-width: 0;
    border-radius: 6px;
    min-height: 22px;
    height: 22px;
}

.mcb-avatar-toggle {
    color: #d1d1d1;
    min-width: 0;
    align-self: flex-start;
}

.mcb-avatar-toggle > .unity-base-field__input,
.mcb-avatar-toggle .unity-toggle__input {
    width: 16px;
    min-width: 16px;
    max-width: 16px;
    height: 16px;
    min-height: 16px;
    flex-grow: 0;
    flex-shrink: 0;
    margin-right: 6px;
}



.mcb-avatar-veins__layout,
.mcb-avatar-sliders__layout {
    flex-direction: row;
    align-items: stretch;
    min-width: 0;
}

.mcb-avatar-veins__image-column {
    width: 110px;
    min-width: 110px;
    justify-content: center;
    align-items: flex-start;
}

.mcb-avatar-veins__image {
    width: 100px;
    height: 100px;
}

.mcb-avatar-veins__controls {
    flex-grow: 1;
    min-width: 0;
}

.mcb-avatar-veins__shader-title {
    margin-top: 8px;
    margin-bottom: 2px;
}

.mcb-avatar-veins__shader-row {
    flex-direction: row;
    align-items: center;
    min-height: 20px;
    margin-bottom: 8px;
}

.mcb-avatar-veins__shader-icon {
    width: 20px;
    height: 20px;
    min-width: 20px;
    margin-right: 4px;
}

.mcb-avatar-veins__preview {
    background-color: #191919;
    border-radius: 8px;
    border-width: 1px;
    border-color: #303030;
    padding: 8px;
    margin-top: 8px;
    margin-bottom: 8px;
}

.mcb-avatar-veins__texture-field {
    min-height: 22px;
    margin-top: 4px;
}

.mcb-avatar-veins__texture-field .unity-base-field__input,
.mcb-avatar-veins__texture-field .unity-object-field__input,
.mcb-avatar-veins__texture-field .unity-object-field__object {
    background-color: #2b2b2b;
    color: #d1d1d1;
    border-width: 0;
    border-radius: 6px;
    min-height: 22px;
    height: 22px;
}

.mcb-avatar-veins__poiyomi-button,
.mcb-avatar-veins__reapply-button {
    align-self: flex-start;
    min-width: 140px;
}

.mcb-avatar-sliders {
    padding-top: 0;
    padding-bottom: 0;
}

.mcb-avatar-sliders__image-panel {
    width: 115px;
    height: 224px;
    min-width: 115px;
    min-height: 224px;
    margin-left: -14px;
    margin-right: 12px;
    position: relative;
    overflow: hidden;
}

.mcb-avatar-sliders__side-image {
    position: absolute;
    left: 0;
    top: 0;
    width: 115px;
    height: 224px;
}

.mcb-avatar-sliders__image-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    padding-left: 32px;
}

.mcb-avatar-sliders__menu-icon {
    width: 50px;
    height: 50px;
    margin-bottom: 2px;
}

.mcb-avatar-sliders__menu-name {
    width: 70px;
    min-width: 70px;
    max-width: 70px;
    min-height: 36px;
    color: #ffffff;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    font-size: 12px;
}

.mcb-avatar-sliders__menu-name .unity-base-field__input,
.mcb-avatar-sliders__menu-name .unity-text-field__input,
.mcb-avatar-sliders__menu-name .unity-text-input {
    background-color: rgba(0,0,0,0);
    border-width: 0;
    color: #ffffff;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    white-space: normal;
    padding: 0;
}

.mcb-avatar-sliders__content {
    flex-grow: 1;
    min-width: 0;
    justify-content: center;
}

.mcb-avatar-sliders__title-row {
    flex-direction: row;
    align-items: center;
    min-width: 0;
}

.mcb-avatar-sliders__title-row .mcb-avatar-option__title {
    flex-grow: 1;
    margin-bottom: 0;
}

.mcb-avatar-sliders__active-toggle {
    width: 32px;
    min-width: 32px;
    align-self: center;
}

.mcb-avatar-graph {
    margin-top: 8px;
    margin-bottom: 12px;
}


.mcb-avatar-sliders__compression-toggle {
    margin-top: 2px;
}

.mcb-avatar-sliders__compression-success {
    margin-top: 4px;
}

.mcb-avatar-sliders__compression-path {
    margin-top: 2px;
}

.mcb-avatar-sliders__pending {
    margin-top: 5px;
}

.mcb-avatar-blendshapes__list {
    background-color: rgba(0,0,0,0);
    border-width: 0;
    padding: 0;
    min-width: 0;
    overflow: hidden;
}

.mcb-avatar-blendshape-row {
    flex-direction: row;
    align-items: center;
    min-width: 0;
    min-height: 24px;
    margin-bottom: 1px;
    overflow: hidden;
}

.mcb-avatar-blendshape-row__slider {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    margin-top: 0;
    margin-bottom: 0;
    margin-right: 6px;
}

.mcb-avatar-blendshape-row__slider .unity-base-field__label {
    min-width: 112px;
    max-width: 170px;
    color: #d1d1d1;
    white-space: nowrap;
    overflow: hidden;
}

.mcb-avatar-blendshape-row__slider .unity-base-field__input {
    min-width: 0;
    flex-shrink: 1;
}

.mcb-avatar-blendshape-row__slider .unity-slider__input {
    min-width: 0;
    flex-shrink: 1;
}

.mcb-avatar-blendshape-row__value {
    width: 52px;
    min-width: 52px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    flex-shrink: 0;
}

.mcb-avatar-blendshape-row__value .unity-base-field__label {
    display: none;
}

.mcb-avatar-blendshape-row__value .unity-base-field__input,
.mcb-avatar-blendshape-row__value .unity-text-field__input,
.mcb-avatar-blendshape-row__value .unity-text-input {
    background-color: #2f2f2f;
    color: #ffffff;
    border-color: #555555;
    border-width: 1px;
    border-radius: 6px;
    min-height: 20px;
    height: 20px;
    padding-left: 5px;
    padding-right: 4px;
}

.mcb-avatar-blendshapes__default-button {
    margin-top: 8px;
    width: 100%;
}
