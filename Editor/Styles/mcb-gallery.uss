.mcb-gallery-toolbar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 24px;
}

.mcb-gallery-toolbar__title {
    margin-right: 14px;
}

.mcb-gallery-toolbar__dropdown {
    width: 180px;
}

/* Asset cards (.orbiters-card, .orbiters-gallery-grid) are Orbiters Toolkit's gallery-card.uss, shared with My Avatar. */

.mcb-selected-title-band {
    background-color: rgba(0,0,0,0);
    padding: 20px 24px 0 24px;
    position: relative;
    overflow: visible;
}

.mcb-selected-banner {
    min-height: 220px;
    margin-top: -20px;
    margin-left: -24px;
    margin-right: -24px;
    margin-bottom: 0;
    background-color: #303030;
    border-radius: 0;
    overflow: hidden;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
    position: relative;
}

.mcb-selected-banner__image {
    width: 100%;
    height: 100%;
    flex-grow: 1;
}

.mcb-selected-banner__message {
    color: #d1d1d1;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.mcb-selected-banner__edit-button {
    position: absolute;
    left: 28px;
    bottom: 50px;
    min-width: 52px;
    height: 26px;
    background-color: rgba(30, 30, 30, 0.88);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.72);
    border-radius: 13px;
    padding-left: 12px;
    padding-right: 12px;
}

.mcb-selected-banner__edit-button:hover {
    background-color: rgba(48, 48, 48, 0.92);
}

.mcb-selected-banner__breadcrumb {
    position: absolute;
    left: 27px;
    top: 17px;
    right: 102px;
    height: 24px;
    flex-direction: row;
    align-items: center;
    min-width: 0;
}

.mcb-selected-banner__breadcrumb-step {
    height: 22px;
    min-height: 22px;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    padding-left: 0;
    padding-right: 0;
    color: #ffffff;
    -unity-font-style: normal;
}

.mcb-selected-banner__breadcrumb-step:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

.mcb-selected-banner__breadcrumb-step Label {
    color: #ffffff;
    font-size: 12px;
}

.mcb-selected-banner__breadcrumb-separator {
    margin-left: 9px;
    margin-right: 9px;
    color: #ffffff;
}

.mcb-selected-banner__breadcrumb-current {
    flex-shrink: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    color: #ffffff;
    -unity-font-style: bold;
}

.mcb-selected-banner__like-button {
    position: absolute;
    top: 13px;
    right: 13px;
    height: 26px;
    min-height: 26px;
    min-width: 51px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: rgba(28, 28, 28, 0.90);
    border-width: 0;
    border-radius: 13px;
    padding-left: 10px;
    padding-right: 10px;
}

.mcb-selected-banner__like-button:hover {
    background-color: rgba(48, 48, 48, 0.94);
}

.mcb-selected-banner__like-button--liked {
    background-color: rgba(35, 54, 40, 0.92);
}

.mcb-selected-banner__like-icon {
    width: 14px;
    height: 14px;
    min-width: 14px;
    margin-right: 6px;
}

.mcb-selected-banner__like-count {
    color: #ffffff;
    font-size: 12px;
    -unity-font-style: bold;
}

.mcb-selected-banner__author {
    position: absolute;
    right: 27px;
    bottom: 52px;
    height: 24px;
    flex-direction: row;
    align-items: center;
    max-width: 230px;
    min-width: 0;
}

.mcb-selected-banner__author-avatar {
    width: 22px;
    height: 22px;
    min-width: 22px;
    border-radius: 11px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.36);
    background-color: #3d3d3d;
    overflow: hidden;
}

.mcb-selected-banner__author-avatar-image {
    width: 100%;
    height: 100%;
    min-width: 100%;
    min-height: 100%;
    flex-grow: 0;
    flex-shrink: 0;
}

.mcb-selected-banner__author-by {
    margin-left: 10px;
    margin-right: 5px;
    color: #ffffff;
}

.mcb-selected-banner__author-name {
    color: #ffffff;
    -unity-font-style: bold;
    flex-shrink: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
}

.mcb-selected-banner__error {
    position: absolute;
    top: 44px;
    right: 14px;
    max-width: 240px;
    color: #ff8c59;
    font-size: 11px;
    white-space: normal;
}

.mcb-selected-actions-host,
.mcb-comments-host {
    flex-grow: 0;
    flex-shrink: 0;
}

.mcb-comments {
    background-color: rgba(0,0,0,0);
    padding: 8px 24px 16px 24px;
    flex-grow: 0;
    flex-shrink: 0;
    position: relative;
    overflow: visible;
}

.mcb-comments__title-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.mcb-comments__title {
    color: #ffffff;
    font-size: 13px;
    -unity-font-style: bold;
}

.mcb-comments__count {
    margin-left: 8px;
    color: #d1d1d1;
    font-size: 12px;
    -unity-font-style: bold;
}

.mcb-comment {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 8px;
    background-color: #212121;
    border-radius: 8px;
    padding: 10px;
}

.mcb-comment__avatar {
    width: 26px;
    height: 26px;
    border-radius: 13px;
    background-color: #3d3d3d;
    overflow: hidden;
}

.mcb-comment__avatar-image {
    flex-grow: 1;
}

.mcb-comment__body {
    flex-grow: 1;
    margin-left: 10px;
}

.mcb-comment__header {
    flex-direction: row;
    align-items: center;
}

.mcb-comment__author {
    flex-grow: 1;
    color: #ffffff;
    font-size: 12px;
    -unity-font-style: bold;
}

.mcb-comment__actions {
    flex-direction: row;
    align-items: center;
}

.mcb-comment__actions .mcb-button--icon-only {
    margin-left: 6px;
    background-color: #4b4b4b;
}

.mcb-comment__actions .mcb-button--icon-only:hover {
    background-color: #626262;
}

.mcb-comment__content {
    white-space: normal;
    margin-top: 3px;
    color: #d1d1d1;
    font-size: 12px;
}

.mcb-comment__edit-actions {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
}

.mcb-comment__edit-actions .mcb-button {
    margin-right: 8px;
}

.mcb-comment-input {
    margin-top: 10px;
    height: 64px;
    min-height: 52px;
    white-space: normal;
    flex-grow: 0;
    flex-shrink: 0;
}

.mcb-comment-input .unity-base-field__input,
.mcb-comment-input .unity-base-text-field__input,
.mcb-comment-input .unity-text-field__input,
.mcb-comment-input .unity-text-input {
    background-color: #575757;
    color: #ffffff;
    border-width: 0;
    border-radius: 8px;
    padding: 8px;
}

.mcb-comment-edit-input {
    margin-top: 7px;
    height: 58px;
    min-height: 50px;
    white-space: normal;
}

.mcb-comment-edit-input .unity-base-field__input,
.mcb-comment-edit-input .unity-base-text-field__input,
.mcb-comment-edit-input .unity-text-field__input,
.mcb-comment-edit-input .unity-text-input {
    background-color: #575757;
    color: #ffffff;
    border-width: 0;
    border-radius: 8px;
    padding: 8px;
}

.mcb-nonmatching-row {
    flex-direction: row;
    margin-top: 14px;
}

.mcb-photoshoot-save-button {
    align-self: stretch;
    margin-bottom: 12px;
}

.mcb-selected-banner__creator-actions {
    position: absolute;
    left: 28px;
    bottom: 50px;
    flex-direction: row;
}
.mcb-selected-banner__creator-actions .mcb-selected-banner__edit-button {
    position: relative;
    left: auto;
    bottom: auto;
    margin-right: 6px;
}

/* Avatar made with a release distributed before MCB (AssetGalleryModule.LegacyMigration). */
.mcb-legacy-notice {
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 8px;
    padding: 12px 14px;
    margin-bottom: 18px;
}

.mcb-legacy-notice__title {
    margin-bottom: 4px;
}

.mcb-legacy-notice__text {
    white-space: normal;
    margin-bottom: 10px;
}

.mcb-legacy-notice__actions {
    align-items: center;
}

.mcb-legacy-notice__status {
    margin-left: 10px;
    white-space: normal;
    flex-shrink: 1;
}


/* The one-time note saying MCB's diagnostics are sent (DiagnosticsNotice), at the bottom of the page above the tabs. */
.mcb-diagnostics-host {
    margin: 4px 24px 18px 24px;
    flex-shrink: 0;
}

.mcb-diagnostics-notice {
    flex-direction: row;
    align-items: flex-start;
    background-color: rgba(255, 255, 255, 0.035);
    border-radius: 10px;
    padding: 12px 12px 12px 12px;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.2s, 0.2s;
    transition-timing-function: ease-out, ease-out;
}

.mcb-diagnostics-notice--leaving {
    opacity: 0;
    translate: 0 6px;
}

.mcb-diagnostics-notice__icon {
    width: 30px;
    height: 30px;
    min-width: 30px;
    border-radius: 8px;
    background-color: rgba(0, 218, 109, 0.10);
    align-items: center;
    justify-content: center;
    margin-right: 12px;
}

.mcb-diagnostics-notice__shield {
    width: 14px;
    height: 16px;
}

.mcb-diagnostics-notice__body {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.mcb-diagnostics-notice__title {
    color: #e8e8e8;
    font-size: 12px;
    -unity-font-style: bold;
    margin: 0 0 3px 0;
    padding: 0;
}

.mcb-diagnostics-notice__text {
    color: #9c9c9c;
    font-size: 11px;
    white-space: normal;
    margin: 0;
    padding: 0;
}

.mcb-diagnostics-notice__links {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.mcb-diagnostics-notice__link {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    margin: 0;
    padding: 0;
    min-height: 0;
    font-size: 11px;
    color: #c4c4c4;
    -unity-text-align: middle-left;
    transition-property: color;
    transition-duration: 0.12s;
}

.mcb-diagnostics-notice__link:hover {
    color: #ffffff;
    background-color: rgba(0, 0, 0, 0);
}

.mcb-diagnostics-notice__link:active {
    color: #00da6d;
    background-color: rgba(0, 0, 0, 0);
}

.mcb-diagnostics-notice__dot {
    color: #6a6a6a;
    font-size: 11px;
    margin: 0 7px;
    padding: 0;
}

.mcb-diagnostics-notice__details {
    color: #8c8c8c;
    font-size: 11px;
    white-space: normal;
    margin: 8px 0 0 0;
    padding: 8px 0 0 0;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.06);
}

.mcb-diagnostics-notice__confirm {
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 0;
    border-radius: 7px;
    color: #f0f0f0;
    font-size: 11px;
    -unity-font-style: bold;
    height: 26px;
    min-height: 26px;
    padding: 0 14px;
    margin: 2px 0 0 12px;
    flex-shrink: 0;
    transition-property: background-color, scale;
    transition-duration: 0.12s, 0.1s;
}

.mcb-diagnostics-notice__confirm:hover {
    background-color: rgba(255, 255, 255, 0.14);
}

.mcb-diagnostics-notice__confirm:active {
    background-color: rgba(0, 218, 109, 0.32);
    scale: 0.97 0.97;
}
