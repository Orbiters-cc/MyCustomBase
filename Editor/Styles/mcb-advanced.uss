.mcb-advanced-refresh {
    margin: 12px;
    padding: 12px;
    background-color: rgb(35, 35, 35);
    border-radius: 8px;
}
.mcb-advanced-refresh__button {
    height: 32px;
    margin: 0;
    background-color: rgb(0, 180, 95);
    color: white;
    border-width: 0;
    border-radius: 5px;
    -unity-font-style: bold;
}
.mcb-advanced-refresh__button:hover { background-color: rgb(0, 200, 110); }
.mcb-advanced-refresh__button:active { background-color: rgb(0, 145, 75); }
.mcb-advanced-refresh__button:disabled { opacity: 0.65; }
.mcb-advanced-refresh__status {
    margin-top: 8px;
    white-space: normal;
    color: rgb(185, 185, 185);
    font-size: 11px;
}
