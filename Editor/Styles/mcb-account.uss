.mcb-loading-bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 158px;
    height: 4px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    overflow: visible;
}

.mcb-loading-bar__track {
    width: 326px;
    max-width: 72%;
    height: 4px;
    background-color: rgba(0,0,0,0);
    border-radius: 2px;
    overflow: hidden;
}

.mcb-loading-bar__fill {
    width: 0;
    height: 4px;
    border-radius: 2px;
    background-color: #00DA6D;
}

.mcb-imgui-top {
    background-color: rgba(0,0,0,0);
    padding-left: 8px;
    padding-right: 8px;
    flex-grow: 0;
    flex-shrink: 0;
}

.mcb-imgui-middle {
    background-color: rgba(0,0,0,0);
    flex-grow: 0;
    flex-shrink: 0;
}

.mcb-imgui-statusbar {
    min-height: 22px;
    flex-grow: 0;
    flex-shrink: 0;
    background-color: #3c3c3c;
}

/* MCB's stage (beta) in the header's top-right corner, where My Avatar puts its badges. */
.mcb-header__stage {
    position: absolute;
    top: 8px;
    right: 10px;
    margin: 0;
}
